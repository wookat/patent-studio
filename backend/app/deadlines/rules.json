{
  "version": 1,
  "notes": [
    "base_date 取值：dates.filed（申请日；有优先权时按细则第十二条以最早优先权日为准的规则写作 effective_filing）、priority（最早优先权日）、dates.grant（授权公告日）、event（由 oa 单元经 deadlines.add 传入的发文日）。",
    "offset 单位 months/years 按细则第五条：起算日当日不计，最后一月相应日届满，无相应日取月末；届满日为周末/法定节假日顺延至次工作日（compute.roll_forward）。",
    "delivery=true 的规则基准日先按细则第四条推定送达：电子送达=发文日，邮寄=发文日+15 日。",
    "kind 需与 app/schemas.DeadlineKind 一致。"
  ],
  "rules": [
    {
      "id": "priority",
      "kind": "priority",
      "title": "优先权期限（首次申请日起 12 个月）",
      "base_date": "priority",
      "offset": {"months": 12},
      "delivery": false,
      "legal_basis": {
        "law": "专利法（2020 修正）",
        "article": "第二十九条",
        "url": "https://www.cnipa.gov.cn/art/2020/11/23/art_524_171347.html"
      }
    },
    {
      "id": "publication",
      "kind": "publication",
      "title": "预计公布日（申请日起满 18 个月）",
      "base_date": "effective_filing",
      "offset": {"months": 18},
      "delivery": false,
      "legal_basis": {
        "law": "专利法（2020 修正）",
        "article": "第三十四条（申请日含优先权日：专利法实施细则第十二条）",
        "url": "https://www.cnipa.gov.cn/art/2020/11/23/art_524_171347.html"
      }
    },
    {
      "id": "exam_request",
      "kind": "exam_request",
      "title": "实质审查请求期限（申请日起 3 年）",
      "base_date": "effective_filing",
      "offset": {"years": 3},
      "delivery": false,
      "legal_basis": {
        "law": "专利法（2020 修正）",
        "article": "第三十五条（申请日含优先权日：专利法实施细则第十二条）",
        "url": "https://www.cnipa.gov.cn/art/2020/11/23/art_524_171347.html"
      }
    },
    {
      "id": "annual_fee",
      "kind": "annual_fee",
      "title": "下一年度年费（上一年度期满前缴纳）",
      "base_date": "dates.grant",
      "offset": {"anniversary_of": "dates.filed"},
      "delivery": false,
      "legal_basis": {
        "law": "专利法实施细则（2023 修订）",
        "article": "第一百一十五条",
        "url": "https://www.cnipa.gov.cn/art/2023/12/21/art_98_189197.html"
      }
    },
    {
      "id": "oa_first_reply",
      "kind": "oa_reply",
      "title": "第一次审查意见通知书答复期限（4 个月）",
      "base_date": "event",
      "offset": {"months": 4},
      "delivery": true,
      "legal_basis": {
        "law": "专利审查指南（2023）",
        "article": "第二部分第八章 4.10.2.2 答复期限",
        "url": "https://www.cnipa.gov.cn/attach/0/%E4%B8%93%E5%88%A9%E5%AE%A1%E6%9F%A5%E6%8C%87%E5%8D%97.pdf"
      }
    },
    {
      "id": "oa_subsequent_reply",
      "kind": "oa_reply",
      "title": "后续审查意见通知书答复期限（2 个月）",
      "base_date": "event",
      "offset": {"months": 2},
      "delivery": true,
      "legal_basis": {
        "law": "专利审查指南（2023）",
        "article": "第二部分第八章 4.10.2.2 答复期限",
        "url": "https://www.cnipa.gov.cn/attach/0/%E4%B8%93%E5%88%A9%E5%AE%A1%E6%9F%A5%E6%8C%87%E5%8D%97.pdf"
      }
    },
    {
      "id": "reexam_notice_reply",
