{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/lint-tokens.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs --verbose",
    "gen:api-types": "cd ../backend && uv run python -c \"import json; from app.main import app; print(json.dumps(app.openapi()))\" > ../frontend/.openapi.tmp.json && cd ../frontend && pnpm exec openapi-typescript .openapi.tmp.json -o src/workbench/openapi.gen.ts && rm .openapi.tmp.json",
    "shots": "node scripts/shot-cdp.mjs",
    "axe": "node scripts/axe-cdp.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
